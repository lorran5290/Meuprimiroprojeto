# Copie este arquivo para .env e preencha os valores.

# Chave da API da Anthropic (obrigatória para o Jarvis responder)
ANTHROPIC_API_KEY=

# Modo de teste sem API: use 1 para respostas prontas, sem custo (só sem a chave acima)
JARVIS_MODO_TESTE=

# Modelo que o Jarvis usa (opcional)
JARVIS_MODEL=claude-sonnet-5-5

# Fuso horário para interpretar "hoje", "amanhã" e os horários dos eventos
JARVIS_TIMEZONE=America/Sao_Paulo

# Credenciais OAuth do Google (veja o README, seção "Conectar o Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Porta do servidor
PORT=3000

# Onde ficam os tokens do Google (padrão: ./data, ignorado pelo git)
JARVIS_DATA_DIR=data
