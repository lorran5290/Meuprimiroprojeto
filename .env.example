# ============================================================
#  LS — configuração local.
#  Copie este arquivo para .env (o instalador faz isso) e preencha.
#  O arquivo .env NUNCA deve ser enviado ao Git (já está no .gitignore).
# ============================================================

# --- Cérebro (Google Gemini) -------------------------------------
# Chave em https://aistudio.google.com/apikey  (formato típico: AIza...)
# Sem chave, o LS funciona só em modo local (memória, sistema, abrir apps).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modelos de reserva, separados por vírgula (usados se o principal ficar sobrecarregado).
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_TIMEOUT_S=60

# --- Pastas do computador que o LS pode tocar ----------------------
# Separadas por ponto e vírgula. Padrão: Desktop, Documentos, Downloads e Imagens do usuário.
# LS_ALLOWED_ROOTS=C:\Users\SeuUsuario\Documents;C:\Users\SeuUsuario\Desktop

# --- Dados locais (memória, auditoria, logs, quarentena) -------------
# Padrão no Windows: %LOCALAPPDATA%\LS
# LS_DATA_DIR=C:\Users\SeuUsuario\AppData\Local\LS

# --- Servidor local da interface -------------------------------------
LS_HOST=127.0.0.1
# 0 = porta livre escolhida automaticamente
LS_PORT=0
LS_LOG_LEVEL=INFO

# --- Tempos limite -----------------------------------------------------
LS_TOOL_TIMEOUT_S=30
LS_CONFIRMATION_TIMEOUT_S=120

# --- Histórico de conversas ----------------------------------------------
LS_KEEP_HISTORY=true

# --- Voz (opcional; exige requirements-voice.txt) -------------------------
LS_VOICE_ENABLED=false
LS_WAKE_WORD_ENABLED=false
LS_WAKE_WORDS=ls,ele esse,elesse
# Pasta do modelo pt-BR do Vosk (baixe e descompacte; veja o README, secao 5)
# LS_VOSK_MODEL_PATH=C:\modelos\vosk-model-small-pt-0.3
# Índice do microfone (opcional). Vazio = microfone padrão.
# LS_MIC_DEVICE=

# --- Fala (voz do Windows, via System.Speech) --------------------------------
LS_TTS_ENABLED=true
# Nome exato de uma voz instalada no Windows (vazio = padrão)
# LS_TTS_VOICE=Microsoft Maria Desktop - Portuguese(Brazil)
LS_TTS_RATE=0
LS_TTS_VOLUME=100

# --- Interface -------------------------------------------------------------
LS_EFFECTS_INTENSITY=1.0
